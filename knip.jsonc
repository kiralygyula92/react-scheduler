{
  // Unused files, exports and dependencies (P4, docs pack 09 §9). Knip's own plugins find every
  // other entry point; the entries and ignores below need saying.
  "workspaces": {
    ".": {
      // Gate and asset scripts are run by name from package.json, not imported; the audit scripts
      // are run by hand for the pre-publish audit (docs pack 09 §10), and the release ones before and
      // after a publish (10 §4).
      "entry": ["scripts/*.ts", "scripts/audit/*.{ts,mjs}", "scripts/release/*.ts"],
      // Lighthouse requires `tslib` without declaring it; the workspace provides it hoisted (.npmrc),
      // so nothing here imports it by name.
      "ignoreDependencies": ["tslib"],
    },
    "apps/docs": {
      // `src/shell/`, `src/i18n/` and `src/lib/` are the site's fixed toolkit: identical in every
      // plugin repository (docs pack 01 §5) and consumed by the page components, which fill up over
      // the content milestones. Their exports are the contract, not dead code.
      // `scripts/serve.ts` is started by Playwright as a command, not imported.
      "entry": ["src/shell/**/*.{ts,tsx}", "src/i18n/**/*.{ts,tsx}", "src/lib/**/*.ts", "scripts/serve.ts"],
      // @react-router/node and isbot are what knip's react-router plugin expects a server build to
      // import. This site prerenders with `ssr: false` and a web-stream entry, so it uses neither.
      // axe-core is injected into the page by path, so no import names it.
      "ignoreDependencies": ["@react-router/node", "isbot", "axe-core"],
    },
  },
}
